# Allow build scripts to be referenced without being copied into the final image
FROM scratch AS ctx
COPY modules /modules
COPY scripts/fedora-dev.sh /fedora-dev.sh
COPY packages/fedora-dev.packages /fedora-dev.packages

FROM ghcr.io/evandurfee/fedora-rpmfusion-toolbox:latest

LABEL com.github.containers.toolbox="true"

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    /usr/bin/bash /ctx/fedora-dev.sh

RUN /usr/local/bin/jetbrains-ide-setup \
	--install-dir /opt/Jetbrains \
	--desktop-dir /usr/local/share/applications \
	idea
RUN /usr/local/bin/jetbrains-ide-setup \
	--install-dir /opt/Jetbrains \
	--desktop-dir /usr/local/share/applications \
	pycharm
RUN /usr/local/bin/jetbrains-ide-setup \
	--install-dir /opt/Jetbrains \
	--desktop-dir /usr/local/share/applications \
	goland
